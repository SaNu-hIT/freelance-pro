DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=freelance_pro
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/freelance_pro
JWT_SECRET=change_me_in_production
PORT=3001
FRONTEND_URL=http://localhost:3000

# Account emails (Brevo SMTP). Leave SMTP_PASS empty to skip sending.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="WorkAI <you@example.com>"

# External assistant API (/api/*): SHA-256 hex of the API key. Make a key with
#   node -e "const k=require('crypto').randomBytes(32).toString('base64url');console.log(k,require('crypto').createHash('sha256').update(k).digest('hex'))"
# give the assistant the key, put only the hash here. Empty = API disabled.
EXTERNAL_API_KEY_HASH=
